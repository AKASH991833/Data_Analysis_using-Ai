# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_a_strong_local_password
DB_NAME=app_db
# true for TiDB Cloud / TLS MySQL
DB_SSL=false
MAX_UPLOAD_MB=50

# Optional server-side Gemini query planning (no rows sent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false
# Required for production: shared single-user HTTP Basic access, not multi-tenancy
APP_USERNAME=
APP_PASSWORD=
